# Server configuration. Copy to .env and fill in the provider you use.
#
# This file is for the SERVER only — the client never needs an API key.
# server/src/resumix_server/resources/models.toml has one [provider] table
# naming the key/endpoint variables below, shared by the six models
# (detect, analysis, letter, cv, review, highlight) — fill in the one provider
# you use.

# --- LLM provider -------------------------------------------------------
# One provider, one key/endpoint pair — any OpenAI-compatible API works. Shipped pointing at Alibaba DashScope (Qwen); to switch, just
# replace the two values below, e.g.:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Ollama:    http://localhost:11434/v1  (MODEL_API_KEY can be any string —
#              Ollama ignores it, but the OpenAI client requires one)
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Second key/endpoint pair, used only by models that set
# use_alternate_provider = 2 in models.toml (or RESUMIX_<ROLE>_USE_ALTERNATE_PROVIDER=2
# below). Leave empty otherwise. A third provider works the same way:
# MODEL_API_KEY3 / MODEL_BASE_URL3 with use_alternate_provider = 3.
# MODEL_API_KEY2=
# MODEL_BASE_URL2=

# --- Per-model overrides -------------------------------------------------
# Any key of a [models.<role>] table in models.toml can be overridden for one
# role without editing the file — handy for Docker: RESUMIX_<ROLE>_<FIELD>.
# Uncomment only what you need; anything unset keeps models.toml's value.
# Roles:  DETECT, ANALYSIS, LETTER, CV, REVIEW, HIGHLIGHT.
# Fields: MODEL, MODEL_PROVIDER ("standard" | "deepseek"), API
#         ("chat_completions" | "responses"), STRUCTURED_OUTPUT ("json_mode" |
#         "json_schema" | "function_calling"), TEMPERATURE, THINKING ("auto" |
#         "on" | "off"), REASONING_EFFORT, MAX_OUTPUT_TOKENS, EXTRA_BODY (JSON,
#         replaces the whole table), USE_ALTERNATE_PROVIDER (1, or N >= 2 for
#         MODEL_API_KEY<N> / MODEL_BASE_URL<N>).
# An empty value (e.g. RESUMIX_CV_TEMPERATURE=) drops the key, as if
# models.toml never declared it — the way to send no temperature to an
# endpoint that rejects one (OpenAI's reasoning models).
# RESUMIX_CV_MODEL=
# RESUMIX_REVIEW_TEMPERATURE=      # shipped at 0; the review loop relies on it
# RESUMIX_REVIEW_EXTRA_BODY={"thinking_budget": 9000}
# RESUMIX_LETTER_EXTRA_BODY={}     # no enable_search: for an endpoint without it (e.g. OpenAI)
# RESUMIX_ANALYSIS_USE_ALTERNATE_PROVIDER=2

# --- Server ------------------------------------------------------------------
# Require this bearer token on every /v1 call. Unset means the server is open
# to anyone who can reach it.
# RESUMIX_API_TOKEN=
# Requests in flight before the server answers 429 (default 10).
# RESUMIX_MAX_CONCURRENT_JOBS=10
# Wall clock for one CV run before it gives up (default 1200s).
# RESUMIX_REQUEST_BUDGET_SECONDS=1200
# Replacement prompts / template / models.toml (default: baked into the image).
# RESUMIX_RESOURCES=/path/to/resources
# Where CV sessions are kept, one directory of events each (default: the system
# temp dir). Mount a volume or a bucket here for them to outlive the container.
# RESUMIX_WORK_DIR=/tmp/resumix
# Days a session nobody acknowledged is kept after its last event (default 1).
# RESUMIX_SESSION_TTL_DAYS=1
# Port uvicorn listens on (default 8080; most platforms inject this).
# PORT=8080

# --- Client ------------------------------------------------------------------
# The client reads these too, but resumix.toml next to the binary is the
# usual way (see client/README.md).
# RESUMIX_API_URL=http://localhost:8080
