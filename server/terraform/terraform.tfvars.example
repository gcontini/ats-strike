# Copy to terraform.tfvars (gitignored) and fill in.

# Beside the 1.x function, in the same account: its own name, and with it its
# own URL, bucket, role and policy. Same registry namespace as the 1.x one.
function_name = "ats-strike-v05"
namespace     = "ats-strike"
log_project   = "serverless-eu-central-1-<uuid>"

environment = {
  MODEL_BASE_URL = "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
  TZ             = "Europe/Rome"
  # The sessions bucket, where main.tf mounts it.
  RESUMIX_WORK_DIR = "/mnt/ats-strike"
  # RESUMIX_CV_MODEL = "qwen-max"
  # Days a CV session nobody acknowledged stays in the bucket.
  # RESUMIX_SESSION_TTL_DAYS = "1"
}

secrets = {
  MODEL_API_KEY = "sk-..."
}

# 32–128 characters from A-Z a-z 0-9 + / = - ~ .  The client sends it as
# `token` in resumix.toml.
api_token = "<random token>"
