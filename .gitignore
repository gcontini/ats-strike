# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# The client's configuration: a server folder's server.toml holds a bearer token.
cv.toml
server.toml

# --- Your data --------------------------------------------------------------
# The fictional set in examples/candidate/ is committed; yours is not. Keep
# your real files next to the client binary, outside the checkout.
/candidate_profile.json
/candidate_data.json
/pers_preferences.md
/candidate_signature.png

# --- Output -----------------------------------------------------------------
# The one folder for anything generated: run outputs, scratch folders, the
# rendered doc site (out/site/), build leftovers. Delete it at will.
/out/
ats-strike-data

# --- Terraform --------------------------------------------------------------
# The state and the variables hold the provider keys and the trigger token in
# clear text. The lock file is committed; the provider cache is not.
.terraform/
*.tfvars
*.tfstate
*.tfstate.*
*.tfplan

# --- Python -----------------------------------------------------------------
.venv/
.venv_win/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.out

.qwen
.vscode
