# --- Secrets ----------------------------------------------------------------
.env
# The client's own configuration: it holds a bearer token.
resumix.toml

# --- Your data --------------------------------------------------------------
# The fictional set in examples/candidate/ is committed; yours is not. Keep
# your real files next to the client binary, outside the checkout.
/candidate_profile.json
/candidate_data.json
/pers_preferences.md
/candidate_signature.png

# --- Output -----------------------------------------------------------------
# Anything a run produced: CVs, spreadsheets, scratch folders.
/applications/
/out/
/examples/out
/resumix-data/*
!/resumix-data/.gitkeep

# --- Docs -------------------------------------------------------------------
# The rendered site. doc/ is the source; mkdocs builds this.
/site/

# --- Terraform --------------------------------------------------------------
# The state and the variables hold the provider keys and the trigger token in
# clear text. The lock file is committed; the provider cache is not.
/server/terraform/.terraform/
/server/terraform/terraform.tfvars
*.tfstate
*.tfstate.*
*.tfplan

# --- Python -----------------------------------------------------------------
.venv/
.venv_win/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.aux
*.log
*.fdb_latexmk
*.fls
*.synctex.gz
*.out

.qwen
.vscode
# --- CV quality runs -----------------------------------------------------------
# Generated CVs carry your contact details.
/tests/cv_quality/runs/
