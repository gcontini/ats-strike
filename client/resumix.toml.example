# resumix client configuration.
#
# resumix reads this from the folder you run it in, or from the path you give
# to --config. Every value here can be overridden on the command line.

# The resumix server to use.
server_url = "http://localhost:8080"

# Only if that server requires one (it will answer 401 without it).
# token = "..."

# Write a cover letter too: "no" | "yes" | "letter_only".
cover_letter = "no"

# Page limit the CV must fit. Omit for the server's own default (2).
# pages = 2

# How long to wait for a CV, in seconds. Writing one takes minutes.
# timeout = 1800    # seconds to follow a CV job before giving up

# Where your files are. Omit any entry and resumix looks for the file by its
# usual name in the folder you run it in; omit it there too and the server's
# own default is used (the two candidate files have no default and are
# required). Images are never listed here: every .png, .jpg and .jpeg in the
# folder is sent under its own name, candidate_signature.png included.
# [files]
# profile                  = "candidate_profile.json"
# candidate_data           = "candidate_data.json"
# preferences              = "candidate_preferences.md"
# template                 = "resume.tex.jinja"
# prompt_jd_evaluation     = "sys_prompt_jd_evaluation.txt"
# prompt_profile_scoring   = "sys_prompt_profile_scoring.txt"
# prompt_format_selection  = "sys_prompt_format_selection.txt"
# prompt_cv_body           = "sys_prompt_cv_body.txt"
# schema_cv_body           = "cv_body_schema.json"
# prompt_cv_duties         = "sys_prompt_cv_duties.txt"
# schema_cv_duties         = "cv_duties_schema.json"
# prompt_validation_body   = "sys_prompt_validation_body.txt"
# prompt_validation_duties = "sys_prompt_validation_duties.txt"
# prompt_highlight         = "sys_prompt_highlight.txt"
# prompt_letter            = "sys_prompt_letter.txt"

# A model role's settings, instead of the server's: a JSON object sent with
# every request, which replaces ALL of that role's settings in the server's
# models.toml for the request. Roles: jd_evaluation, profile_scoring,
# format_selection, cv, validation, highlight (the CV's six steps), analysis
# and letter.
# [extra_body.cv]
# temperature = 0.4
# top_p       = 0.9
