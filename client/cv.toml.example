# ats-strike client configuration: cv.toml, in your data folder.
#
# ats-strike reads it from the folder you run it in, from --data-dir, or from
# the path you give to --config. It says nothing about any server but which
# folders hold one: everything else about a server is in that folder's
# server.toml (see server.toml.example).

# The server folders, relative to this file. Each one's name is the name
# --server_ver takes and the suffix its PDFs get.
servers = ["v11"]

# The server that analyses every posting and writes the cover letter: one of
# the folders above. Optional while only one server is listed.
# default_server = "v11"

# Write a cover letter too: "no" | "yes" | "letter_only". The default server
# writes it.
cover_letter = "no"

# Print what each server reports about each step, and every line it logs.
verbose = false
