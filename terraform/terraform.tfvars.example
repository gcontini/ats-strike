# Copy to terraform.tfvars (gitignored) and fill in.

function_name = "ats-strike"
log_project   = "serverless-eu-central-1-<uuid>"

environment = {
  MODEL_BASE_URL = "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
  # DeepSeek (provider 2), OpenAI (3), an Alibaba Model Studio workspace (4): see doc/build-server.md.
  MODEL_BASE_URL2 = "https://api.deepseek.com"
  MODEL_BASE_URL3 = "https://api.openai.com/v1"
  MODEL_BASE_URL4 = "https://<workspace>.maas.aliyuncs.com/compatible-mode/v1"
  TZ             = "Europe/Rome"
  # The sessions bucket, where main.tf mounts it.
  ATS_WORK_DIR = "/mnt/ats-strike"
  # Days a CV session nobody acknowledged stays in the bucket.
  # ATS_SESSION_TTL_DAYS = "1"
}

secrets = {
  MODEL_API_KEY  = "sk-..."
  MODEL_API_KEY2 = "sk-..."
  MODEL_API_KEY3 = "sk-..."
  MODEL_API_KEY4 = "sk-..."
}

# 32–128 characters from A-Z a-z 0-9 + / = - ~ .  The client sends it as
# `token` in cv.toml.
api_token = "<random token>"
